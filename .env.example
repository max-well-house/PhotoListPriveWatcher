# Google Sheet ID (from the sheet URL)
SHEET_ID=

# Path to service-account JSON (worker only; never commit this file)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# Optional: Items tab name (default: Items)
SHEET_ITEMS_TAB=Items

# Optional: Config tab name (default: Config)
SHEET_CONFIG_TAB=Config

# Optional: User-Agent for retailer fetches
HTTP_USER_AGENT=FamilyPriceTracker/0.1 (+personal-family-use)
